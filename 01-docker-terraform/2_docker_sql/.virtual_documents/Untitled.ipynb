import dlt
import requests

# Define a simple function to fetch data from an API
def get_nyc_taxi_data():
    url = "https://us-central1-dlthub-analytics.cloudfunctions.net/data_engineering_zoomcamp_api"
    response = requests.get(url)
    response.raise_for_status()
    return response.json()  # Convert API response to JSON

# Create a dlt pipeline with PostgreSQL as the destination
pipeline = dlt.pipeline(
    pipeline_name="nyc_taxi_pipeline",
    destination="postgres",  # Specify PostgreSQL as the destination
    dataset_name="nyc_taxi_data"  # Dataset name inside PostgreSQL
)

# Run the pipeline to load data
load_info = pipeline.run(
    get_nyc_taxi_data(),    # Function returning the data
    table_name="rides",      # PostgreSQL table name
    write_disposition="replace"  # Replace data on each run
)

# Print summary of data load
print(load_info)

